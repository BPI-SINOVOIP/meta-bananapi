# Short-description: Create image for eSD
# Long-description: Creates a image that can be used to write to eSD for Bananapi boards

part --source rawcopy --sourceparams="file=bl2_bp_esd-${MACHINE}.bin" --no-table
part --source rawcopy --sourceparams="file=fip-${MACHINE}.bin" --no-table --offset 768s --align 64

part --source rootfs            --fstype=ext4 --label yocto_root       --align 1024
