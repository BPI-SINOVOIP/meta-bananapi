@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: GPL-2.0
+dtbo-$(CONFIG_ARCH_RENESAS) += \
+	bpi-ai2n-i2c1.dtbo \
+	bpi-ai2n-i2c1-flash.dtbo \
+	bpi-ai2n-i2c1-rtc.dtbo \
+	bpi-ai2n-i2c2.dtbo \
+	bpi-ai2n-uart0.dtbo \
+	bpi-ai2n-uart2.dtbo \
+	bpi-ai2n-pwm.dtbo \
+	bpi-ai2n-pwmfan.dtbo \
+	bpi-ai2n-spi0.dtbo \
+	bpi-ai2n-spi2.dtbo \
+	bpi-ai2n-spi2-flash.dtbo \
+	bpi-ai2n-spi2-waveshare-st7789v.dtbo \
+	bpi-ai2n-spi2-waveshare-tft24.dtbo \
+	bpi-ai2n-spi2-waveshare-tft35c.dtbo \
+	bpi-ai2n-i2s3-nxez-pcm512x.dtbo \
+	bpi-ai2n-i2s3-waveshare-wm8960.dtbo \
+	bpi-ai2n-i2c0-mux.dtbo
+
+dtbo-$(CONFIG_ARCH_RENESAS) += \
+	rzv2n-evk-cam-imx415.dtbo \
+	rzv2n-evk-cam-imx415-dual.dtbo \
+	rzv2n-evk-cam-waveshare-imx415.dtbo \
+	rzv2n-evk-cam-luckfox-imx415.dtbo \
+	rzv2n-evk-cam-imx462.dtbo \
+	rzv2n-evk-cam-ov5640.dtbo
+
+scr-$(CONFIG_ARCH_RENESAS) += \
+	rzv2n-fixup.scr
+
+dtbotxt-$(CONFIG_ARCH_RENESAS) += \
+	README.rzv2n-overlays
+
+targets += $(dtbo-y) $(scr-y) $(dtbotxt-y)
+
+always-y       := $(dtbo-y) $(scr-y) $(dtbotxt-y)
+clean-files    := *.dtbo *.scr
diff --git a/arch/arm64/boot/dts/renesas/overlay/README.rzv2n-overlays b/arch/arm64/boot/dts/renesas/overlay/README.rzv2n-overlays
new file mode 100644
index 000000000000..b372d97992de
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/overlay/README.rzv2n-overlays
@@ -0,0 +1,18 @@
+This document describes overlays provided in the kernel packages
+For generic Renesas overlays
+
+### Platform:
+
+rzv2n (Renesas)
+
+### Provided overlays:
+
+- i2c4
+
+### Overlay details:
+
+### i2c4
+
+Activates TWI/I2C bus 4
+
+I2C4 pins (SCL, SDA): GPIO PIN.3, GPIO PIN.5
diff --git a/arch/arm64/boot/dts/renesas/overlay/bpi-ai2n-i2c0-mux.dts b/arch/arm64/boot/dts/renesas/overlay/bpi-ai2n-i2c0-mux.dts
new file mode 100644
index 000000000000..c7716de0f3d0
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/overlay/bpi-ai2n-i2c0-mux.dts
@@ -0,0 +1,57 @@
+/dts-v1/;
+/plugin/;
+#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	compatible = "renesas,r9a09g056";
+
+	fragment@0 {
+		target-path = "/aliases";
+		__overlay__ {
+			i2c9 = &i2c_mux0;
+			i2c10 = &i2c_mux1;
+			i2c11 = &i2c_mux2;
+			i2c12 = &i2c_mux3;
+		};
+	};
+
+	fragment@1 {
+		target = <&i2c0>;
+		__overlay__ {
+			status = "okay";
+
+			pca9545: i2c-mux@70 {
+				compatible = "nxp,pca9545";
+				reg = <0x70>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				reset-gpios = <&pinctrl RZG2L_GPIO(7, 4) GPIO_ACTIVE_HIGH>;
+
+				i2c_mux0: i2c@0 {
+				    reg = <0>;
+				    #address-cells = <1>;
+				    #size-cells = <0>;
+				};
+
+				i2c_mux1: i2c@1 {
+				    reg = <1>;
+				    #address-cells = <1>;
+				    #size-cells = <0>;
+				};
+
+				i2c_mux2: i2c@2 {
+				    reg = <2>;
+				    #address-cells = <1>;
+				    #size-cells = <0>;
+				};
+
+				i2c_mux3: i2c@3 {
+				    reg = <3>;
+				    #address-cells = <1>;
+				    #size-cells = <0>;
+				};
+			};
+		};	
+	};
+};
